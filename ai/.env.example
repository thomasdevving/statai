# Copy to ai/.env (untracked). Never commit a real key: the repository is public.

# Gemini API key (AI Studio). Needed only when fake mode is off.
GEMINI_API_KEY=

# 1 = deterministic fake responses, no network, no key needed.
GHOSTCHEF_AI_FAKE=1

# Which real provider to use when fake mode is off: gemini (the product) or openai
# (TEMPORARY dev stand-in while Gemini access is pending; check/watch only).
# GHOSTCHEF_PROVIDER=gemini
# OPENAI_API_KEY=

# Hard cap on paid model calls per process (protects small credits). 0 = unlimited.
# Default: 300 for openai, unlimited for gemini.
# GHOSTCHEF_MAX_CALLS=300

# Optional model overrides. Verified IDs are recorded in ai/STATUS.md by AI-02.
# GHOSTCHEF_MODEL_VIDEO=
# GHOSTCHEF_MODEL_CHECK=
# GHOSTCHEF_MODEL_WATCH=
# GHOSTCHEF_MODEL_LIVE=

# Optional: where sushi_recipe.json and images/ live (default: ai/fixtures).
# GHOSTCHEF_FIXTURE_DIR=

# Optional: fake-mode delay in seconds (default 0.3; check uses x2.5, extract x4). Tests use 0.
# GHOSTCHEF_AI_FAKE_DELAY=0.3
