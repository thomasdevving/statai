// Copy to Config/Secrets.xcconfig (untracked) and fill in. Never commit the copy.
//
// "//" starts a comment in xcconfig files, so a URL needs an empty variable
// between the slashes: http:/$()/192.168.1.20:8000

// Backend base URL: a teammate's laptop on the LAN, or the Railway URL from backend/STATUS.md.
API_BASE_URL = http:/$()/192.168.1.20:8000
// The shared X-Demo-Key value (ask the backend owner).
DEMO_API_KEY = replace-me

// Optional: your Apple team id and, if needed, a bundle id your team can sign.
// DEVELOPMENT_TEAM = ABCDE12345
// GHOSTCHEF_BUNDLE_ID = com.yourname.ghostchef

// Optional: Meta Wearables Developer Center values (only needed outside Developer Mode).
// META_APP_ID = 1234567890
// CLIENT_TOKEN = AR|1234567890|abcdef
