# Copy to .env (untracked). Every variable is read in app/config.py.

# Value clients send in X-Demo-Key. Use a long random string in production.
DEMO_API_KEY=dev-key

# memory | supabase
STORAGE=memory

# Local file root for the memory store
DATA_DIR=.data

# Required when STORAGE=supabase (BE-02)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Read by ghostchef_ai: 1 = fake AI, 0 = real Gemini
GHOSTCHEF_AI_FAKE=1
# Required when GHOSTCHEF_AI_FAKE=0 (read by ghostchef_ai)
GEMINI_API_KEY=

# Model time budgets in seconds (API-CONTRACT §3)
CHECK_BUDGET_S=8
WATCH_BUDGET_S=3.5

# Signed URL lifetime in seconds
SIGNED_URL_TTL_S=7200

# Video size limit in MB
MAX_VIDEO_MB=500

# Comma-separated origins; restrict in production
CORS_ORIGINS=*

# Static web app, mounted at /app/ when the directory exists
WEB_DIR=../web

# Used to build local file URLs in memory mode; empty = derived from the request
PUBLIC_BASE_URL=

# Failure rehearsal (BE-07.2). Leave both unset in production: with FAULT_INJECT_ENABLED=1 and a
# FAULT_INJECT value, any request carrying the header `X-Fault: 1` fails like the model did.
# FAULT_INJECT=timeout          # timeout | quota | unavailable
# FAULT_INJECT_ENABLED=1
